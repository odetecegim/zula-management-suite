# ---- Google Sheets (Zula Suite) ----
# Bu dosyayi "server/.env" veya kokte ".env" olarak kopyalayip doldurun.

# 1) Servis hesabi JSON'u (tek satir) - VEYA asagida 2. secenegi kullanin
GOOGLE_SERVICE_ACCOUNT_JSON=

# 2) Servis hesabi JSON dosya yolu (onerilen)
GOOGLE_SERVICE_ACCOUNT_PATH=./server/service-account.json

# 3) Varsayilan tablo (panelde degistirilebilir)
SHEETS_SPREADSHEET_ID=
SHEETS_RANGE=A1:Z2000

# 4) Backend portu
PORT=8787
